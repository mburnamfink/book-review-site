---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('posts');
  const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return sorted.map(entry => ({
    params: { slug: entry.id },
    props: { entry, allEntries: sorted },
  }));
}

const { entry, allEntries } = Astro.props;
const { Content } = await render(entry);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="index-layout">
    <aside class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-heading">Posts</div>
        <ul class="sidebar-links">
          {allEntries.map(e => (
            <li>
              <a
                href={`/posts/${e.id}/`}
                class:list={['sidebar-link', { active: e.id === entry.id }]}
              >
                <span>{e.data.title}</span>
                <span class="sidebar-count">{e.data.date.getFullYear()}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <article class="index-main">
      <h1 class="prose-title">{entry.data.title}</h1>
      <time class="post-date" datetime={entry.data.date.toISOString()}>
        {formatDate(entry.data.date)}
      </time>
      <div class:list={['review-body', { interview: entry.data.interview }]}>
        <Content />
      </div>
    </article>
  </div>
</Base>
