---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('posts');
  const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return sorted.map(entry => ({
    params: { slug: entry.id },
    props: { entry, allEntries: sorted },
  }));
}

const { entry, allEntries } = Astro.props;
const { Content } = await render(entry);

// Resolve the optional share image to an absolute URL against `site`.
const ogImage = entry.data.image
  ? new URL(entry.data.image, Astro.site).href
  : undefined;

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const origin = new URL(Astro.site!).origin;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonical}#post`,
  url: canonical,
  mainEntityOfPage: canonical,
  headline: entry.data.title,
  ...(entry.data.description ? { description: entry.data.description } : {}),
  datePublished: entry.data.date.toISOString(),
  author: { '@id': `${origin}/#person` },
  publisher: { '@id': `${origin}/#person` },
  ...(ogImage ? { image: ogImage } : {}),
};
---

<Base title={entry.data.title} description={entry.data.description} ogImage={ogImage} jsonLd={blogSchema}>
  <div class="index-layout">
    <aside class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-heading">Posts</div>
        <ul class="sidebar-links">
          {allEntries.map(e => (
            <li>
              <a
                href={`/posts/${e.id}/`}
                class:list={['sidebar-link', { active: e.id === entry.id }]}
              >
                <span>{e.data.title}</span>
                <span class="sidebar-count">{e.data.date.getFullYear()}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <article class="index-main">
      <h1 class="prose-title">{entry.data.title}</h1>
      <time class="post-date" datetime={entry.data.date.toISOString()}>
        {formatDate(entry.data.date)}
      </time>
      <div class:list={['review-body', { interview: entry.data.interview }]}>
        <Content />
      </div>
    </article>
  </div>

  {/* Behavior for the conversation-log blocks; all harmless if none exist */}
  <script is:inline>
    // Expand-all / collapse-all toolbar
    document.querySelectorAll('.chat-controls [data-chat-all]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.dataset.chatAll === 'open';
        document.querySelectorAll('details.claude').forEach((d) => { d.open = open; });
      });
    });

    // Copy a prompt's text to the clipboard
    document.querySelectorAll('.prompt__copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.parentElement.querySelector('.prompt__text')?.innerText ?? '';
        try {
          await navigator.clipboard.writeText(text.trim());
          btn.textContent = 'copied';
          btn.classList.add('copied');
          setTimeout(() => { btn.textContent = 'copy'; btn.classList.remove('copied'); }, 1200);
        } catch { /* clipboard unavailable */ }
      });
    });
  </script>
</Base>
