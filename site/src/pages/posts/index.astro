---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="Other Posts">
  <div class="index-layout">
    <aside class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-heading">Posts</div>
        <ul class="sidebar-links">
          {posts.map(p => (
            <li>
              <a href={`/posts/${p.id}/`} class="sidebar-link">
                {p.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <div class="index-main">
      <h1 class="prose-title">Other Posts</h1>
      <ul class="post-list">
        {posts.map(p => (
          <li class="post-list__item">
            <a href={`/posts/${p.id}/`} class="post-list__title">{p.data.title}</a>
            <time class="post-list__date" datetime={p.data.date.toISOString()}>
              {formatDate(p.data.date)}
            </time>
            {p.data.description && (
              <p class="post-list__desc">{p.data.description}</p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>
