---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map(review => {
    const parts = review.id.split('/');
    return {
      params: { type: parts[0], slug: parts[1] },
      props: { review },
    };
  });
}

const { review } = Astro.props;
const { type, slug } = Astro.params;
let Content: any;
try {
  ({ Content } = await render(review));
} catch (e) {
  console.error(`Failed to render review ${review.id}:`, e);
  Content = () => null;
}
const d = review.data;

function authorLine(authors: typeof d.authors) {
  return authors
    .map(a => [a.first, a.last].filter(Boolean).join(' '))
    .join(', ');
}

const STAR_PATH = 'M10,1 L12.06,7.17 L18.56,7.22 L13.33,11.08 L15.29,17.28 L10,13.5 L4.71,17.28 L6.67,11.08 L1.44,7.22 L7.94,7.17 Z';
let _sid = 0;

function starSvg(fraction: number): string {
  const id = 'sr' + (_sid++);
  const w = (fraction * 20).toFixed(2);
  return `<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-2px"><defs><clipPath id="${id}"><rect x="0" y="0" width="${w}" height="20"/></clipPath></defs><path d="${STAR_PATH}" fill="var(--star-empty)"/><path d="${STAR_PATH}" fill="var(--star-fill)" clip-path="url(#${id})"/><path d="${STAR_PATH}" fill="none" stroke="var(--star-stroke)" stroke-width="1.5"/></svg>`;
}

function stars(rating: number): string {
  let html = `<span class="star-row" aria-label="${rating} out of 5 stars">`;
  for (let i = 1; i <= 5; i++) {
    const fraction = Math.min(1, Math.max(0, rating - (i - 1)));
    html += starSvg(fraction);
  }
  return html + '</span>';
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}

function formatRuntime(decimalHours: number): string {
  const h = Math.floor(decimalHours);
  const m = Math.round((decimalHours - h) * 60);
  return m > 0 ? `${h}h ${m}m` : `${h}h`;
}

const sortedReads = [...d.reads].sort((a, b) => b.year - a.year);
const latestRead = sortedReads[0];
const readYears = sortedReads.map(r => r.year).join(', ');

const coverUrl = `/${type}/${slug}/cover.jpg`;
const ogCoverUrl = `/${type}/${slug}/og-cover.jpg`;

const description = d.authors.length
  ? `A review of ${d.title} by ${authorLine(d.authors)}.`
  : `A review of ${d.title}.`;
---

<Base title={d.title} description={description} ogImage={d.og_cover ? ogCoverUrl : undefined}>
  <h1 class="review-title">{d.title}</h1>
  <p class="review-byline">by {authorLine(d.authors)}</p>

  <div class="review-sidebar">
    <div class="review-cover-wrap">
      {d.cover
        ? <img class="review-cover-img" src={coverUrl} alt={`Cover of ${d.title}`} />
        : <div class="cover-placeholder" style="aspect-ratio: 2/3; font-size: 0.9rem;">{d.title}</div>
      }
    </div>

    <div class="review-meta">
      {d.rating !== undefined && (
        <p class="rating-display"><Fragment set:html={stars(d.rating)} /> <span class="rating-num">({d.rating} / 5)</span></p>
      )}

      {d.tags.length > 0 && (
        <div class="tags">
          {d.tags.map(tag => <a href={`/?tag=${encodeURIComponent(tag)}`} class="tag">{tag}</a>)}
        </div>
      )}

      <table class="meta-table">
        <tbody>
          {d.publication_year && (
            <tr><th>Published</th><td>{d.publication_year}{d.publisher ? ` · ${d.publisher}` : ''}</td></tr>
          )}
          {d.series && (
            <tr><th>Series</th><td>{d.series}{d.series_number != null ? ` #${d.series_number}` : ''}</td></tr>
          )}
          {d.type === 'book' && d.page_count && (
            <tr><th>Pages</th><td>{d.page_count}</td></tr>
          )}
          {d.type === 'audiobook' && d.narrator && (
            <tr><th>Narrator</th><td>{[d.narrator.first, d.narrator.last].filter(Boolean).join(' ')}</td></tr>
          )}
          {d.type === 'audiobook' && d.runtime_hours && (
            <tr><th>Runtime</th><td>{formatRuntime(d.runtime_hours!)}{d.abridged ? ' (abridged)' : ''}</td></tr>
          )}
          {d.type === 'rpg' && d.system && (
            <tr><th>System</th><td>{d.system}</td></tr>
          )}
          {d.isbn && (
            <tr><th>ISBN</th><td>{d.isbn}</td></tr>
          )}
          {latestRead?.date_started && (
            <tr><th>Date Started</th><td>{formatDate(latestRead.date_started)}</td></tr>
          )}
          {latestRead?.date_finished && (
            <tr><th>Date Finished</th><td>{formatDate(latestRead.date_finished)}</td></tr>
          )}
          {d.reads.length > 0 && (
            <tr><th>Read</th><td>{readYears}</td></tr>
          )}
          <tr><th>Reviewed</th><td>{formatDate(d.date_reviewed)}</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <hr class="divider" />

  <div class="review-body">
    <Content />
  </div>

  <hr class="divider" />

  <section class="bsky-section">
    <h2 class="bsky-heading">Discussion</h2>
    {d.bsky_post
      ? <div id="bsky-comments" data-uri={d.bsky_post}><p class="bsky-muted">Loading discussion…</p></div>
      : <a id="bsky-share-btn" href="#" target="_blank" rel="noopener noreferrer" class="bsky-share-btn">Post about this on Bluesky</a>
    }
  </section>
</Base>

<script>
// Share button — build intent URL client-side so it picks up the live page URL
const shareBtn = document.getElementById('bsky-share-btn');
if (shareBtn) {
  const title = document.querySelector('.review-title')?.textContent?.trim() ?? document.title;
  shareBtn.href =
    'https://bsky.app/intent/compose?text=' +
    encodeURIComponent(title + '\n' + location.href);
}

// Comment section
const commentsEl = document.getElementById('bsky-comments');
if (commentsEl) loadThread(toAtUri(commentsEl.dataset.uri), commentsEl);

function toAtUri(raw) {
  // Accept either a web URL or an AT URI
  if (raw.startsWith('at://')) return raw;
  // https://bsky.app/profile/{handle}/post/{rkey}
  const m = raw.match(/bsky\.app\/profile\/([^/]+)\/post\/([^/?#]+)/);
  if (m) return `at://${m[1]}/app.bsky.feed.post/${m[2]}`;
  return raw;
}

function atToUrl(uri) {
  const [did, , rkey] = uri.replace('at://', '').split('/');
  return `https://bsky.app/profile/${did}/post/${rkey}`;
}

function esc(s) {
  return String(s ?? '')
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function fmtDate(iso) {
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
  });
}

function renderReply(tp, depth = 0) {
  if (tp?.$type !== 'app.bsky.feed.defs#threadViewPost' || !tp.post) return '';
  const { post, replies = [] } = tp;
  const a = post.author;
  const indent = depth > 0 ? ` style="margin-left:${depth * 1.5}rem"` : '';

  const nested = replies
    .filter(r => r.$type === 'app.bsky.feed.defs#threadViewPost')
    .sort((a, b) => (b.post?.likeCount ?? 0) - (a.post?.likeCount ?? 0))
    .slice(0, depth === 0 ? 50 : 5)
    .map(r => renderReply(r, depth + 1))
    .join('');

  return `
    <div class="bsky-comment"${indent}>
      <div class="bsky-comment-header">
        ${a.avatar
          ? `<img class="bsky-avatar" src="${esc(a.avatar)}" alt="" loading="lazy">`
          : '<div class="bsky-avatar bsky-avatar--empty"></div>'}
        <div class="bsky-author">
          <span class="bsky-display-name">${esc(a.displayName || a.handle)}</span>
          <a href="https://bsky.app/profile/${esc(a.handle)}" class="bsky-handle" target="_blank" rel="noopener">@${esc(a.handle)}</a>
        </div>
        <a href="${esc(atToUrl(post.uri))}" class="bsky-date" target="_blank" rel="noopener">${fmtDate(post.record?.createdAt)}</a>
      </div>
      <p class="bsky-text">${esc(post.record?.text ?? '')}</p>
      ${post.likeCount ? `<span class="bsky-likes">♥ ${post.likeCount}</span>` : ''}
      ${nested}
    </div>`;
}

async function loadThread(uri, el) {
  try {
    const res = await fetch(
      `https://public.api.bsky.app/xrpc/app.bsky.feed.getPostThread` +
      `?uri=${encodeURIComponent(uri)}&depth=6&parentHeight=0`
    );
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const { thread } = await res.json();

    if (thread.$type !== 'app.bsky.feed.defs#threadViewPost') {
      el.innerHTML = '<p class="bsky-muted">Post not found or unavailable.</p>';
      return;
    }

    const { post, replies = [] } = thread;
    const validReplies = replies
      .filter(r => r.$type === 'app.bsky.feed.defs#threadViewPost')
      .sort((a, b) => (b.post?.likeCount ?? 0) - (a.post?.likeCount ?? 0));

    el.innerHTML = `
      <div class="bsky-stats">
        <a href="${esc(atToUrl(uri))}" target="_blank" rel="noopener" class="bsky-thread-link">View on Bluesky</a>
        <span>♥ ${post.likeCount ?? 0} likes</span>
        <span>${post.repostCount ?? 0} reposts</span>
        <span>${post.replyCount ?? 0} replies</span>
      </div>
      ${validReplies.length
        ? `<div class="bsky-comment-list">${validReplies.map(r => renderReply(r)).join('')}</div>`
        : '<p class="bsky-muted">No replies yet.</p>'
      }`;
  } catch (e) {
    el.innerHTML = `<p class="bsky-muted">Could not load discussion: ${esc(e.message)}</p>`;
  }
}
</script>
