---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('booksOfYear');
  const sorted = all.sort((a, b) => b.data.year - a.data.year);
  return sorted.map(entry => ({
    params: { slug: entry.id },
    props: { entry, allEntries: sorted },
  }));
}

const { entry, allEntries } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="index-layout">
    <aside class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-heading">Books of the Year</div>
        <ul class="sidebar-links">
          {allEntries.map(e => (
            <li>
              <a
                href={`/books-of-year/${e.id}/`}
                class:list={['sidebar-link', { active: e.id === entry.id }]}
              >
                {e.data.year}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <article class="index-main">
      <h1 class="prose-title">{entry.data.title}</h1>
      <div class="review-body">
        <Content />
      </div>
    </article>
  </div>
</Base>
