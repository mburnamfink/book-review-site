const body = document.getElementById('body');
const hrow = document.getElementById('hrow');
const countEl = document.getElementById('count');
let sortKey = 'disp', sortDir = -1, typeFilter = 'all', statusFilter = 'all', query = '', hidden = loadHidden();

// header
COLS.forEach(c=>{
  const th = document.createElement('th');
  th.textContent = c.label;
  if(c.num) th.classList.add('num');
  th.dataset.key = c.k;
  const ar = document.createElement('span'); ar.className='ar'; ar.textContent='▲';
  th.appendChild(ar);
  th.addEventListener('click',()=>{
    if(sortKey===c.k){ sortDir*=-1; } else { sortKey=c.k; sortDir=c.num?-1:1; }
    render();
  });
  hrow.appendChild(th);
});

// column visibility menu
const colMenu = document.getElementById('colMenu');
const colMenuWrap = document.getElementById('colMenuWrap');
COLS.forEach(c=>{
  const lab = document.createElement('label');
  const cb = document.createElement('input');
  cb.type = 'checkbox'; cb.checked = !hidden.has(c.k); cb.dataset.key = c.k;
  cb.addEventListener('change',()=>{
    if(cb.checked) hidden.delete(c.k); else hidden.add(c.k);
    saveHidden();
    applyCols();
  });
  lab.appendChild(cb);
  lab.append(' '+c.label);
  colMenu.appendChild(lab);
});
document.getElementById('showAll').addEventListener('click',()=>{
  hidden.clear();
  colMenu.querySelectorAll('input').forEach(cb=>cb.checked=true);
  saveHidden();
  applyCols();
});
// close the menu when clicking elsewhere
document.addEventListener('click',e=>{
  if(colMenuWrap.open && !colMenuWrap.contains(e.target)) colMenuWrap.open=false;
});

const STORE_KEY = 'warships:hiddenCols';
function loadHidden(){
  try{
    const valid = new Set(COLS.map(c=>c.k));
    return new Set((JSON.parse(localStorage.getItem(STORE_KEY)) || []).filter(k=>valid.has(k)));
  }catch(e){ return new Set(); }
}
function saveHidden(){
  try{ localStorage.setItem(STORE_KEY, JSON.stringify([...hidden])); }catch(e){}
}

function applyCols(){
  document.querySelectorAll('.warships th[data-key],.warships td[data-col]').forEach(el=>{
    el.style.display = hidden.has(el.dataset.key || el.dataset.col) ? 'none' : '';
  });
}

function statusCell(s){
  if(s==='cancel') return '<span class="dot s-cancel"></span>Cancelled';
  if(s==='build')  return '<span class="dot s-build"></span>Building / planned';
  if(s==='service+build') return '<span class="dot s-service"></span>In service &amp; building';
  return '<span class="dot s-service"></span>In service';
}

function render(){
  const q = query.trim().toLowerCase();
  let rows = D.filter(d=>{
    if(typeFilter!=='all' && d.type!==typeFilter) return false;
    if(statusFilter!=='all'){
      if(statusFilter==='service' && !d.status.includes('service')) return false;
      if(statusFilter==='build'  && !d.status.includes('build'))   return false;
      if(statusFilter==='cancel' && d.status!=='cancel')           return false;
    }
    if(q){
      const hay = (d.name+' '+d.desig+' '+d.country+' '+d.radar+' '+d.type).toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });

  rows.sort((a,b)=>{
    let va=a[sortKey], vb=b[sortKey];
    if(typeof va==='number' && typeof vb==='number') return (va-vb)*sortDir;
    va=(''+va).toLowerCase(); vb=(''+vb).toLowerCase();
    return va<vb?-sortDir : va>vb?sortDir : 0;
  });

  body.innerHTML = rows.map(d=>{
    const cost = d.cost2026==null ? '—'
      : '≈'+d.cost2026.toFixed(2)+(d.costEst?'<span class="est">*</span>':'');
    return `<tr>
      <td class="name" data-col="name">${d.name}<span class="desig">${d.desig}</span></td>
      <td data-col="country">${d.country}</td>
      <td data-col="type"><span class="type-pill type-${d.type}">${d.type==='Destroyer'?'DDG':d.type==='Frigate'?'FFG':'LCS'}</span></td>
      <td class="num" data-col="disp">${d.disp.toLocaleString()}</td>
      <td class="num" data-col="length">${d.length}</td>
      <td class="num" data-col="beam">${d.beam}</td>
      <td class="num" data-col="vls">${d.vls}<span class="vnote">${d.vnote}</span></td>
      <td class="wrapcell" data-col="radar">${d.radar}</td>
      <td class="wrapcell" data-col="aviation">${d.aviation}</td>
      <td class="num" data-col="crew">${d.crew}</td>
      <td class="wrapcell" data-col="costRep">${d.costRep}</td>
      <td class="num" data-col="cost2026">${cost}</td>
      <td class="num" data-col="commYear">${d.commLabel}</td>
      <td class="wrapcell" data-col="built">${d.built}</td>
      <td class="status" data-col="status">${statusCell(d.status)}</td>
    </tr>`;
  }).join('');

  countEl.textContent = rows.length+' of '+D.length+' classes';
  [...hrow.children].forEach(th=>{
    th.classList.toggle('sorted', th.dataset.key===sortKey);
    const ar=th.querySelector('.ar');
    if(th.dataset.key===sortKey) ar.textContent = sortDir>0?'▲':'▼';
    else ar.textContent='▲';
  });

  applyCols();
}

document.getElementById('typeSeg').addEventListener('click',e=>{
  const b=e.target.closest('button'); if(!b) return;
  typeFilter=b.dataset.type;
  [...e.currentTarget.children].forEach(x=>x.classList.toggle('on',x===b));
  render();
});
document.getElementById('statusSel').addEventListener('change',e=>{statusFilter=e.target.value;render();});
document.getElementById('q').addEventListener('input',e=>{query=e.target.value;render();});

render();
</script>
