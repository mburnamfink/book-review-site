---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const raw = (await getCollection('reviews')).filter(r => {
  try { return r.data.date_reviewed instanceof Date && !isNaN(r.data.date_reviewed.getTime()); }
  catch { return false; }
});

function serverSlugify(str: string): string {
  return str.toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const reviewData = raw.map(r => {
  const parts = r.id.split('/');
  const type = parts[0];
  const slug = parts[1];
  const primaryAuthors = r.data.authors.filter(
    a => a.role === 'author' || a.role === 'editor'
  );
  return {
    type,
    slug,
    title: r.data.title,
    authors: primaryAuthors.map(a => ({
      first: a.first ?? '',
      last: a.last,
      slug: serverSlugify([a.first ?? '', a.last].filter(Boolean).join(' ')),
    })),
    rating: r.data.rating ?? null,
    tags: r.data.tags,
    readYears: [...new Set(r.data.reads.map(rd => rd.year))].sort((a, b) => b - a),
    hasCover: !!r.data.cover,
    dateReviewed: r.data.date_reviewed.toISOString().slice(0, 10),
    lastReadDate: (() => {
      const sorted = [...r.data.reads].sort((a, b) => b.year - a.year);
      const d = sorted[0]?.date_finished ?? sorted[0]?.date_started ?? null;
      return d ? (d as Date).toISOString().slice(0, 10) : String(sorted[0]?.year ?? 0);
    })(),
  };
});

const tagCounts: Record<string, number> = {};
const yearCounts: Record<number, number> = {};
for (const r of reviewData) {
  for (const tag of r.tags) tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  for (const y of r.readYears) yearCounts[y] = (yearCounts[y] || 0) + 1;
}

const allTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag, count]) => ({ tag, count }));

const allYears = Object.entries(yearCounts)
  .map(([y, count]) => ({ year: parseInt(y), count }))
  .sort((a, b) => b.year - a.year);

const currentYear = new Date().getFullYear();
const currentYearEntries = allYears.filter(y => y.year === currentYear);
const pastYears = allYears.filter(y => y.year !== currentYear);

const decadeMap = new Map<number, typeof pastYears>();
for (const y of pastYears) {
  const decade = Math.floor(y.year / 10) * 10;
  if (!decadeMap.has(decade)) decadeMap.set(decade, []);
  decadeMap.get(decade)!.push(y);
}
const decades = [...decadeMap.entries()]
  .sort(([a], [b]) => b - a)
  .map(([decade, years]) => ({ decade, years }));
---

<Base title="Book Reviews">

  <div class="index-layout">
    <aside class="sidebar">
      <details class="sidebar-details" open>
        <summary class="sidebar-toggle">Filters</summary>
        <div class="sidebar-contents">
          <div class="sidebar-section">
            <div class="sidebar-heading">Year</div>
            <ul class="sidebar-links">
              <li><button class="sidebar-link" data-filter-year="">All years</button></li>
              {currentYearEntries.map(({ year, count }) => (
                <li>
                  <button class="sidebar-link" data-filter-year={String(year)}>
                    {year}<span class="sidebar-count">{count}</span>
                  </button>
                </li>
              ))}
              {decades.map(({ decade, years }) => (
                <li class="decade-item">
                  <details class="decade-details">
                    <summary class="sidebar-link decade-summary">
                      {decade}s<span class="sidebar-count">{years.reduce((s, y) => s + y.count, 0)}</span>
                    </summary>
                    <ul class="sidebar-links decade-years">
                      {years.map(({ year, count }) => (
                        <li>
                          <button class="sidebar-link" data-filter-year={String(year)}>
                            {year}<span class="sidebar-count">{count}</span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ))}
            </ul>
          </div>

          <div class="sidebar-section">
            <div class="sidebar-heading">Tags</div>
            <ul class="sidebar-links">
              <li><button class="sidebar-link" data-filter-tag="">All tags</button></li>
              {allTags.map(({ tag, count }) => (
                <li>
                  <button class="sidebar-link" data-filter-tag={tag}>
                    {tag}<span class="sidebar-count">{count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </details>
    </aside>

    <div class="index-main">
      <div class="index-toolbar">
        <span id="review-count" class="review-count-label"></span>
        <div class="sort-bar">
          <span class="sort-label">Sort:</span>
          <button class="sort-btn" data-sort="date">Date</button>
          <button class="sort-btn" data-sort="rating">Rating</button>
          <button class="sort-btn" data-sort="title">Title</button>
          <button class="sort-btn" data-sort="author">Author</button>
        </div>
      </div>
      <div id="review-list" class="review-grid"></div>
    </div>
  </div>
</Base>

<script define:vars={{ reviewData }}>
const reviews = reviewData;

function getParams() {
  const p = new URLSearchParams(location.search);
  return {
    tag:    p.get('tag')    || '',
    year:   p.get('year')   || '',
    author: p.get('author') || '',
    sort:   p.get('sort')   || 'date',
    dir:    p.get('dir')    || '',
    search: p.get('q')      || '',
  };
}

function setParam(key, value) {
  const p = new URLSearchParams(location.search);
  if (value) p.set(key, value); else p.delete(key);
  const qs = p.toString();
  history.pushState({}, '', qs ? '?' + qs : location.pathname);
}

function setParams(updates) {
  const p = new URLSearchParams(location.search);
  for (const [key, value] of Object.entries(updates)) {
    if (value) p.set(key, value); else p.delete(key);
  }
  const qs = p.toString();
  history.pushState({}, '', qs ? '?' + qs : location.pathname);
}

function filterReviews(list, { tag, year, author, search }) {
  const q = search.toLowerCase();
  return list.filter(r => {
    if (tag    && !r.tags.includes(tag))                               return false;
    if (year   && !r.readYears.includes(parseInt(year)))               return false;
    if (author && !r.authors.some(a => a.slug === author))             return false;
    if (q) {
      const titleMatch  = r.title.toLowerCase().includes(q);
      const authorMatch = r.authors.some(a =>
        `${a.first} ${a.last}`.toLowerCase().includes(q)
      );
      if (!titleMatch && !authorMatch) return false;
    }
    return true;
  });
}

function sortReviews(list, by, dir) {
  const s = [...list];
  if (by === 'rating') {
    s.sort((a, b) => (b.rating ?? -1) - (a.rating ?? -1) || a.title.localeCompare(b.title));
    return dir === 'rev' ? s.reverse() : s;
  }
  if (by === 'title') {
    s.sort((a, b) => a.title.localeCompare(b.title));
    return dir === 'rev' ? s.reverse() : s;
  }
  if (by === 'author') {
    s.sort((a, b) => {
      const al = a.authors[0]?.last || '', bl = b.authors[0]?.last || '';
      return al.localeCompare(bl) || a.title.localeCompare(b.title);
    });
    return dir === 'rev' ? s.reverse() : s;
  }
  // default: date (most recent read date, then dateReviewed as tiebreak)
  s.sort((a, b) => b.lastReadDate.localeCompare(a.lastReadDate) || b.dateReviewed.localeCompare(a.dateReviewed));
  return dir === 'rev' ? s.reverse() : s;
}

const STAR_PATH = 'M10,1 L12.06,7.17 L18.56,7.22 L13.33,11.08 L15.29,17.28 L10,13.5 L4.71,17.28 L6.67,11.08 L1.44,7.22 L7.94,7.17 Z';
let _sid = 0;

function starSvg(fraction) {
  const id = 'sr' + (_sid++);
  const w = (fraction * 20).toFixed(2);
  return `<svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-1px"><defs><clipPath id="${id}"><rect x="0" y="0" width="${w}" height="20"/></clipPath></defs><path d="${STAR_PATH}" fill="var(--star-empty)"/><path d="${STAR_PATH}" fill="var(--star-fill)" clip-path="url(#${id})"/><path d="${STAR_PATH}" fill="none" stroke="var(--star-stroke)" stroke-width="1.5"/></svg>`;
}

function stars(rating) {
  if (rating == null) return '';
  let html = `<span class="star-row" aria-label="${rating} out of 5 stars">`;
  for (let i = 1; i <= 5; i++) {
    const fraction = Math.min(1, Math.max(0, rating - (i - 1)));
    html += starSvg(fraction);
  }
  return html + '</span>';
}

function esc(str) {
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function renderItem(r) {
  const href     = `/${r.type}/${r.slug}/`;
  const coverUrl = `/${r.type}/${r.slug}/cover.jpg`;

  const coverHtml = r.hasCover
    ? `<img class="card-cover" src="${esc(coverUrl)}" alt="" loading="lazy">`
    : `<div class="cover-placeholder">${esc(r.title)}</div>`;

  const displayAuthors = r.authors.slice(0, 3);
  const authorHtml = displayAuthors.map(a => {
    const name = [a.first, a.last].filter(Boolean).join(' ');
    return `<button class="author-link" data-filter-author="${esc(a.slug)}">${esc(name)}</button>`;
  }).join(', ') + (r.authors.length > 3 ? ', et al.' : '');

  const starsHtml = r.rating != null ? stars(r.rating) : 'DNF';

  return `
    <div class="review-card">
      <a href="${esc(href)}">${coverHtml}</a>
      <p class="card-title"><a href="${esc(href)}">${esc(r.title)}</a></p>
      <p class="card-author">${authorHtml}</p>
      <p class="card-rating">${starsHtml}</p>
    </div>`;
}

function updateUI(params) {
  // sidebar active states
  document.querySelectorAll('.sidebar-link[data-filter-tag]').forEach(el => {
    el.classList.toggle('active', el.dataset.filterTag === params.tag);
  });
  document.querySelectorAll('.sidebar-link[data-filter-year]').forEach(el => {
    el.classList.toggle('active', el.dataset.filterYear === params.year);
  });
  document.querySelectorAll('.decade-details').forEach(el => {
    el.querySelector('.decade-summary')?.classList.remove('has-active');
  });
  if (params.year) {
    const activeYearBtn = document.querySelector(`.sidebar-link[data-filter-year="${params.year}"]`);
    const details = activeYearBtn?.closest('details');
    if (details) {
      details.open = true;
      details.querySelector('.decade-summary')?.classList.add('has-active');
    }
  }
  document.querySelectorAll('.sort-btn').forEach(el => {
    const isActive = el.dataset.sort === params.sort;
    el.classList.toggle('active',     isActive && params.dir !== 'rev');
    el.classList.toggle('active-rev', isActive && params.dir === 'rev');
  });
}

function attachListHandlers() {
  document.querySelectorAll('#review-list [data-filter-tag]').forEach(el => {
    el.addEventListener('click', () => {
      const cur = getParams();
      setParam('tag', cur.tag === el.dataset.filterTag ? '' : el.dataset.filterTag);
      render();
    });
  });
  document.querySelectorAll('#review-list [data-filter-year]').forEach(el => {
    el.addEventListener('click', () => {
      const cur = getParams();
      setParam('year', cur.year === el.dataset.filterYear ? '' : el.dataset.filterYear);
      render();
    });
  });
  document.querySelectorAll('#review-list [data-filter-author]').forEach(el => {
    el.addEventListener('click', () => {
      const cur = getParams();
      setParam('author', cur.author === el.dataset.filterAuthor ? '' : el.dataset.filterAuthor);
      render();
    });
  });
}

function render() {
  const params   = getParams();
  const filtered = filterReviews(reviews, params);
  const sorted   = sortReviews(filtered, params.sort, params.dir);

  document.getElementById('review-list').innerHTML = sorted.map(renderItem).join('');

  const countEl = document.getElementById('review-count');
  if (countEl) {
    const total = reviews.length;
    countEl.textContent = filtered.length < total
      ? `${filtered.length.toLocaleString()} of ${total.toLocaleString()} reviews`
      : `${total.toLocaleString()} reviews`;
  }

  updateUI(params);
  attachListHandlers();

  // Sync search input without stealing focus
  const searchEl = document.getElementById('search-input');
  if (searchEl && searchEl !== document.activeElement) {
    searchEl.value = params.search;
  }
}

// Sidebar filter buttons
document.querySelectorAll('.sidebar-link[data-filter-tag]').forEach(el => {
  el.addEventListener('click', () => {
    const cur = getParams();
    setParam('tag', cur.tag === el.dataset.filterTag ? '' : el.dataset.filterTag);
    render();
  });
});
document.querySelectorAll('.sidebar-link[data-filter-year]').forEach(el => {
  el.addEventListener('click', () => {
    const cur = getParams();
    setParam('year', cur.year === el.dataset.filterYear ? '' : el.dataset.filterYear);
    render();
  });
});

// Sort buttons
document.querySelectorAll('.sort-btn').forEach(el => {
  el.addEventListener('click', () => {
    const params = getParams();
    if (el.dataset.sort === params.sort) {
      setParams({ dir: params.dir === 'rev' ? '' : 'rev' });
    } else {
      setParams({ sort: el.dataset.sort, dir: '' });
    }
    render();
  });
});

// Search input
let searchTimer;
document.getElementById('search-input').addEventListener('input', e => {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => {
    setParam('q', e.target.value.trim());
    render();
  }, 180);
});

window.addEventListener('popstate', render);

// The search input lives in the header form — prevent full-page submit on this page
document.querySelector('.header-search')?.addEventListener('submit', e => e.preventDefault());

render();

// Collapse sidebar filters by default on mobile
const sidebarDetails = document.querySelector('.sidebar-details');
if (sidebarDetails && window.innerWidth < 721) {
  sidebarDetails.removeAttribute('open');
}
</script>
