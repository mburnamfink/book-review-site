---
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    // Visible <h1> when it should differ from the <title>/SEO title.
    heading?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="prose-page">
    <h1 class="prose-title">{frontmatter.heading ?? frontmatter.title}</h1>
    <div class="review-body">
      <slot />
    </div>
  </article>
</Base>
